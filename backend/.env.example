PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

DATABASE_URL="file:./dev.db"

JWT_SECRET=change_me_to_a_long_random_string

ADMIN_EMAIL=admin@pixential.in
ADMIN_PASSWORD=change_me_please

# Leave empty to store uploads in backend/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Email. Leave SMTP_HOST empty to print emails in the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pixential <hello@pixential.in>"
NOTIFY_EMAIL=hello@pixential.in
